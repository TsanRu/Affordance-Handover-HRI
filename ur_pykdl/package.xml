<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_pykdl</name>
  <version>0.2.0</version>
  <description>Simple implementation of PyKDL kinematics + kdl_parser_py (ROS 2 port).</description>

  <maintainer email="cristian.beltran@sinicx.com">Cristian Beltran</maintainer>
  <author email="beltran@hlab.sys.es.osaka-u.ac.jp">Cristian Beltran</author>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ur_control</depend>
  <exec_depend>python3-pykdl</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
